# ─── Application ───────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ─── Database ───────────────────────────────────────────────────
# MUST point to a staging/testing cluster (production URLs are rejected at startup)
DATABASE_URL=postgresql+asyncpg://sigs_user:sigs_pass@localhost:5432/sigs_db
DATABASE_SSL_MODE=disable
# Allowed DB host suffixes for environment isolation check (comma-separated)
ALLOWED_DB_HOSTS=localhost,timescaledb,*-staging,*-test

# ─── MQTT Broker ────────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=8883
MQTT_USE_TLS=false
MQTT_CA_CERT_PATH=
MQTT_CLIENT_CERT_PATH=
MQTT_CLIENT_KEY_PATH=
MQTT_TOPIC_PREFIX=telemetry/#
MQTT_CLIENT_ID=sigs-rs-gateway

# ─── Security Middleware ────────────────────────────────────────
# Sliding-window (Anomalous Packet Inspector)
INSPECTOR_WINDOW_SECONDS=10
INSPECTOR_MAX_PACKETS_PER_WINDOW=50
INSPECTOR_WINDOW_CLEANUP_INTERVAL=60

# Privacy Anonymizer PII fields (comma-separated JSON paths)
ANONYMIZER_PII_FIELDS=latitude,longitude,lat,lon,mac_address,device_id,geo

# Maximum telemetry payload size in bytes (SRS REQ-TI-3: 512 KB)
MAX_PAYLOAD_SIZE_BYTES=524288

# ─── Circuit Breaker ────────────────────────────────────────────
CIRCUIT_BREAKER_FAILURE_THRESHOLD_MS=2000
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# ─── Authentication ─────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Seeded admin user (Security Engineer role)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_ROLE=security_engineer

# ─── Ingestion Queue ────────────────────────────────────────────
INGESTION_QUEUE_MAX_SIZE=10000
