# .gitignore for SIGS-RS

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# ─── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Environment files ─────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ─── TLS Certificates (generate locally, never commit) ────────────────────────
certs/*.crt
certs/*.key
certs/*.pem
certs/*.p12

# ─── Pytest ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ─── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ─── Docker ───────────────────────────────────────────────────────────────────
# (Docker Compose override for local secrets)
docker-compose.override.yml

# ─── Database ─────────────────────────────────────────────────────────────────
*.sql.backup
pgdata/

# Local environment variables and secrets
.env
.env.*
!.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Local Python environments
.venv/
venv/
__pycache__/
.pytest_cache/
